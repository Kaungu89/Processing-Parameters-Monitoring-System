rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive definition helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kaungu89@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email']) &&
             data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('employmentNumber' in data) || (data.employmentNumber is string && data.employmentNumber.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation for ShiftRecord
    function isValidShiftRecord(data) {
      return data.keys().hasAll(['id', 'ownerId', 'date', 'time', 'operatorEmail', 'pads', 'ponds']) &&
             data.id is string && isValidId(data.id) &&
             data.ownerId is string && isValidId(data.ownerId) && data.ownerId == request.auth.uid &&
             data.date is string && data.date.size() >= 8 && data.date.size() <= 32 &&
             data.time is string && data.time.size() >= 3 && data.time.size() <= 16 &&
             data.operatorEmail is string && data.operatorEmail.size() >= 5 && data.operatorEmail.size() <= 256 &&
             data.pads is list && data.pads.size() <= 50 &&
             data.ponds is map &&
             (!('operatorName' in data) || (data.operatorName is string && data.operatorName.size() <= 128)) &&
             (!('employmentNumber' in data) || (data.employmentNumber is string && data.employmentNumber.size() <= 64)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
             (!('extraTelemetry' in data) || (data.extraTelemetry is map)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Test connection probe document
    match /test/connection {
      allow read: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().email == existing().email;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Shifts Collection
    match /shifts/{shiftId} {
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(shiftId) &&
                    incoming().id == shiftId &&
                    isValidShiftRecord(incoming());
      allow update: if isSignedIn() && isValidId(shiftId) &&
                    (existing().ownerId == request.auth.uid || isAdmin()) &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().id == existing().id &&
                    isValidShiftRecord(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'pads', 'ponds', 'extraTelemetry', 'updatedAt', 'operatorName', 'employmentNumber', 'date', 'time', 'operatorEmail']);
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
